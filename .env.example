# Copy to .env.local and fill in the keys. Keys stay on the server; never
# prefix them with NEXT_PUBLIC_.

# These defaults use the course-issued BUILD LLM Proxy. Each key only works on
# its own route, in that provider's native API format. To use your own provider
# accounts, replace the base URLs and set the optional model ID overrides.
OPENAI_BASE_URL=https://proxy.litechat.ai/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL_ID=
ANTHROPIC_BASE_URL=https://proxy.litechat.ai/anthropic/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=
GOOGLE_GENERATIVE_AI_BASE_URL=https://proxy.litechat.ai/google/v1beta
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_MODEL_ID=

# SQLite database file (created on first run).
DATABASE_PATH=./data/litechat.db
